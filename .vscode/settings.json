{
  // Python
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Editor
  "editor.tabSize": 4,
  "editor.rulers": [100],
  "editor.wordWrap": "off",
  "editor.formatOnSave": false,
  "files.encoding": "utf8",

  // File Explorer — oculta pastas/arquivos irrelevantes
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    ".venv": true,
    "html": true,
    "debug_*.png": true,
    "log_erros.txt": true,
    "log_sucesso.txt": true,
    "log_monitor_final.txt": true,
    "resultados_worker_*.xlsx": true,
    "cnpjs.xlsx.xlsx": true,
    "*.lock": true
  },

  // Search — não indexar .venv nem dados brutos
  "search.exclude": {
    ".venv": true,
    "cidades_pequenas": true,
    "**/__pycache__": true
  },

  // Explorer
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "config.py": "checkpoint.py, logger.py, excel_reader.py",
    "main_municipio.py": "complemento_fase2.py, monitor_e_mesclar.py, aguardar_e_finalizar.py"
  },

  // Terminal
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.env.windows": {
    "PYTHONIOENCODING": "utf-8"
  }
}
